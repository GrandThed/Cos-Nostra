# Variables the bot reads, all validated at startup by src/config.js. Copy the names into the
# repo-root .env (loaded by `npm run bot` through --env-file-if-exists) or set them as Railway
# variables on the `bot` service. Never commit real values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Bot token from the Discord application (Bot -> Reset Token)
DISCORD_TOKEN=
# Application id of the same Discord application, used to register slash commands
DISCORD_CLIENT_ID=
# Shared with the backend. Signs both directions: the bot's calls to /internal and the
# backend's calls to the bot's POST /post. Min 16 characters, must match the backend.
BOT_SHARED_SECRET=
# Base URL of the backend, http or https, trailing slashes are stripped.
# http://localhost:3000 locally, https://cosnostra.benja.ar in production.
BACKEND_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Port of the internal HTTP server (GET /health, POST /post). Default 3001.
# Must match the backend's BOT_INTERNAL_URL.
BOT_PORT=
# Guild used for development so slash commands register instantly instead of
# taking up to an hour to propagate globally. Leave empty in production.
DISCORD_DEV_GUILD_ID=
# error, warn, info or debug. Default info.
LOG_LEVEL=
