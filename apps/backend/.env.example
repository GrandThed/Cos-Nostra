# Backend variables. Locally these are read from the repo-root .env (see /.env.example);
# on Railway set them on the backend service. All of them are validated at startup.

PORT=3000
PUBLIC_URL=https://cosnostra.benja.ar

# postgres://... on Railway (reference the Postgres plugin), pglite://memory for tests,
# pglite://./data/dev for a local on-disk database with no Postgres install.
DATABASE_URL=pglite://./data/dev

# Random strings, at least 16 characters. BOT_SHARED_SECRET must match the bot service.
JWT_SECRET=
BOT_SHARED_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot's internal HTTP server; leave empty until the bot is deployed (phase 4).
BOT_INTERNAL_URL=

# Object storage over the S3 API. On Railway reference the bucket's variables:
#   S3_ENDPOINT=${{Bucket.ENDPOINT}}  S3_REGION=${{Bucket.REGION}}  S3_BUCKET=${{Bucket.BUCKET}}
#   S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}  S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# Leave all empty locally to run without uploads (upload routes answer 503).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# virtual (Railway, R2) or path (older Railway buckets, MinIO)
S3_URL_STYLE=virtual

# Upload limits. A presigned PUT is signed for exactly the size the desktop declares, so
# MAX_CLIP_MB is the ceiling on what one upload URL can ever write to the bucket, and
# USER_QUOTA_GB caps what one account can hold in total (0 disables the quota).
MAX_CLIP_MB=2048
USER_QUOTA_GB=50

LOG_LEVEL=info
