# Cos Nostra local environment. Copy to .env at the repo root; .env is gitignored, never commit it.
# Backend and bot load it automatically through `node --env-file-if-exists=../../.env`.
# In production the same names are set as Railway variables on each service
# (see .claude/skills/railway-deploy/SKILL.md for the per-service list).

# ---------------------------------------------------------------------------
# Discord application  (https://discord.com/developers/applications)
# One application provides both the bot token and the OAuth client.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
# Guild used for development so slash commands register instantly
DISCORD_DEV_GUILD_ID=
# Optional. Base of the Discord REST API; tests point it at a local stub.
# DISCORD_API_BASE=https://discord.com/api

# ---------------------------------------------------------------------------
# Backend  (apps/backend)  -- every variable is validated at startup
# ---------------------------------------------------------------------------
PORT=3000
# Public base URL, no trailing slash. Must match the OAuth redirect
# registered in Discord: <PUBLIC_URL>/auth/discord/callback
PUBLIC_URL=http://localhost:3000
# Random 32+ char string used to sign device tokens (min 16)
JWT_SECRET=
# Shared between backend and bot for internal calls (min 16)
BOT_SHARED_SECRET=
# Where the backend reaches the bot's internal HTTP server. Optional until phase 4.
BOT_INTERNAL_URL=http://localhost:3001

# Database. postgres://... for real Postgres (Railway plugin in production),
# pglite://./data/dev for an on-disk PGlite database with no Postgres install,
# pglite://memory for a throwaway one.
DATABASE_URL=pglite://./data/dev

# Object storage over the S3 API. Leave all empty locally to run without uploads
# (upload routes answer 503). On Railway these come from the Storage Bucket references.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# virtual (Railway buckets, R2) or path (older Railway buckets, MinIO)
S3_URL_STYLE=virtual

# pino level: trace, debug, info, warn, error, silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Bot  (apps/bot)
# ---------------------------------------------------------------------------
# Port of the bot's internal HTTP server (/post, /health)
BOT_PORT=3001
# Where the bot reaches the backend
BACKEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Raises GitHub rate limits when the desktop bootstrapper downloads the OBS runtime
GITHUB_TOKEN=
# Rust log filter for the desktop app during `npm run desktop`
RUST_LOG=info
